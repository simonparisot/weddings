# Environment Variables for Lambda Functions
# Copy this to .env and fill in your actual values
# NEVER commit the actual .env file!

# ===================================
# Stripe Configuration
# ===================================
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# Optional: For Stripe Connect
STRIPE_ACCOUNT_ID=acct_xxxxx

# ===================================
# AWS Configuration
# ===================================
AWS_REGION=eu-west-1
TABLE_NAME=wedding-rsvp-production
# Optional: For custom domains
S3_BUCKET=example.fr

# ===================================
# Google Sheets Integration
# ===================================
# Get this from Google Cloud Console → Service Accounts
# Format: Full JSON string on one line
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}
SHEET_ID=your-google-sheet-id

# ===================================
# Site Configuration
# ===================================
SITE_DOMAIN=example.fr
SUCCESS_URL=https://example.fr/merci.html
CANCEL_URL=https://example.fr/

# ===================================
# Optional: Email Notifications
# ===================================
# SENDGRID_API_KEY=SG.xxxxx
# NOTIFICATION_EMAIL=you@example.com
